# Copie estes nomes para Settings > Environment Variables na Vercel.
# Nunca coloque os valores reais no GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Opcional: IDs do Telegram que podem usar o bot, separados por vírgula (descubra com /id)
ALLOWED_USERS=
# Opcional: trocar os links do rodapé sem mexer no código
LINK_JB=https://jogobara.to/M05ex
LINK_INDICA=https://jogobara.to/S3cM9
# Opcional: link do nome no rodapé do Telegram ("Canais de Promoções do ..."); sem isso usa os de cima
LINK_TG_JB=
LINK_TG_INDICA=
# Opcional: encurtar links no YOURLS do Jogo Barato
# (YOURLS > Tools > "Secure passwordless API call" > signature token)
YOURLS_SIGNATURE=
YOURLS_API=https://jogobara.to/yourls-api.php
# Opcional: enviar a oferta pros grupos do WhatsApp pelo SendFlow (só funciona com ALLOWED_USERS preenchido)
# Depois de colocar a chave, mande /sendflow pro bot pra ver os lançamentos e os IDs
SENDFLOW_API_KEY=
SENDFLOW_LANCAMENTO_JB=
SENDFLOW_LANCAMENTO_INDICA=
# Opcional: ID da conta (número) que envia; sem isso usa a do lançamento
SENDFLOW_CONTA=
